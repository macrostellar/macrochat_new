# Copy to .env and use the same Supabase project as your working web app.
# Project Settings > API / Connect: use the Project URL and public anon/publishable key.
# Never use a service-role or secret key. These EXPO_PUBLIC values are bundled into the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SIGNALING_URL=
# Optional, development only: set true with both Supabase values blank for local samples.
EXPO_PUBLIC_DEMO_MODE=false
