PORT=4000
ALLOWED_ORIGINS=http://localhost:8081,https://app.example.com
JWT_SECRET=replace_me
JWT_AUDIENCE=authenticated
# Optional but recommended: set to your auth issuer URL
# JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1

# Required when REQUIRE_CONVERSATION_MEMBERSHIP=true
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Keep true in production so calls are only allowed between real conversation members
REQUIRE_CONVERSATION_MEMBERSHIP=true

# Basic anti-abuse rate controls per socket/event/window
EVENT_LIMIT_WINDOW_MS=4000
EVENT_LIMIT_MAX=80
