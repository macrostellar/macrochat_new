# coturn example config for MacroChat
listening-port=3478
tls-listening-port=5349
realm=macrochat.local
fingerprint
lt-cred-mech
use-auth-secret
static-auth-secret=REPLACE_WITH_LONG_SECRET
no-multicast-peers
no-cli

# cert paths (for TLS TURN)
cert=/etc/letsencrypt/live/turn.example.com/fullchain.pem
pkey=/etc/letsencrypt/live/turn.example.com/privkey.pem

# optional relay range
min-port=49160
max-port=49200
